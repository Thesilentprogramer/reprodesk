# Testnet only. Generate agent keys into this gitignored .env with npm run setup.
NEAR_TESTNET_PARENT_ACCOUNT=your-account.testnet
NEAR_TESTNET_PARENT_PRIVATE_KEY=ed25519:replace-me
CONTRACT_ACCOUNT=reprodesk.your-account.testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
MAINNET_ARCHIVAL_RPC=https://archival-rpc.mainnet.fastnear.com

# Optional prose generation; without a working key reports use an explicit template.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=deepseek/deepseek-v3.2
